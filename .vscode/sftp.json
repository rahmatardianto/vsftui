// VS Code SFTP & VSFTUI Configuration
{
  "name": "Local-Dev",
  "host": "127.0.0.1",
  "protocol": "sftp",
  "port": 22,
  "username": "arch",
  "privateKeyPath": "~/.ssh/id_ed25519",
  "remotePath": "/tmp/vsftui_remote",
  "uploadOnSave": true,
  "useTempFile": true,
  "ignore": [
    "**/.git/**",
    "**/.vscode/**",
    "**/target/**",
  ],
  // Extended Git Auto-Sync Configuration
  "gitAutoSync": {
    "enabled": true,
    "includeUntracked": true,
    "includeStaged": true,
    "includeModified": true,
    "propagateDeletes": false,
    "debounceMs": 300,
  },
  "profiles": {
    "staging": {
      "host": "staging.internal",
      "remotePath": "/var/www/staging",
    },
    "production": {
      "host": "prod.internal",
      "remotePath": "/var/www/production",
      "useTempFile": true,
    },
  },
}
